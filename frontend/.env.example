VITE_API_URL=http://127.0.0.1:8000

# Weather overlay layers (Temperature/Wind/Pressure toggles) — optional.
# Free key, no card required: https://openweathermap.org/api
VITE_OWM_API_KEY=

# CARTO basemap (the voyager map tiles) — required as of ~August 2026, when
# CARTO started requiring a key on all basemaps.cartocdn.com tile requests.
# Still free (5M tile requests/month, non-commercial, no approval queue):
# https://carto.com/basemaps/apikey/ — leave unset and the map still loads,
# just with a visible "API KEY REQUIRED" watermark on every tile.
VITE_CARTO_API_KEY=
