# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# ── Google Earth Engine ───────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name

# For Render deployment — paste entire service account JSON as one line
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── ACLED conflict data (optional, free) ──────────────────────────────────────
# ACLED migrated to OAuth in 2025 — there is no more "API key", just your
# myACLED account email + password. Register free at https://acleddata.com
ACLED_EMAIL=
ACLED_PASSWORD=

# ── AIS maritime vessel tracking (optional) ────────────────────────────────────
# The backend no longer connects to AISStream.io directly — it polls our own
# bridge service instead. Deploy /ais-bridge first (see ais-bridge/README.md),
# then point these at it. AISSTREAM_API_KEY itself is set on the bridge, not here.
AIS_BRIDGE_URL=
AIS_BRIDGE_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
JOB_TTL_SECONDS=3600
