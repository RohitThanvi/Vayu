# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# ── Google Earth Engine ───────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name

# For Render deployment — paste entire service account JSON as one line
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── ACLED conflict data (optional, free) ──────────────────────────────────────
# ACLED migrated to OAuth in 2025 — there is no more "API key", just your
# myACLED account email + password. Register free at https://acleddata.com
ACLED_EMAIL=
ACLED_PASSWORD=

# ── AISStream maritime vessel tracking (optional, free) ───────────────────────
# Register free, no credit card, at https://aisstream.io
AISSTREAM_API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
JOB_TTL_SECONDS=3600
